{
  "name": "margin-pdf",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local PDF reader with AI explanations through Codex and Devin CLI.",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
